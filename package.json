{
  "name": "tollgate",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w gateway",
    "dev:ui": "npm run dev -w dashboard",
    "build": "npm run build -w gateway && npm run build -w dashboard",
    "test": "npm run test -w gateway",
    "typecheck": "npm run typecheck -w gateway && npm run typecheck -w dashboard",
    "migrate": "node -e \"Object.entries(require('fs').readFileSync('.env','utf8').split('\\n').reduce((o,l)=>{const[k,...v]=l.split('=');k&&!k.trim().startsWith('#')&&(o[k]=v.join('='));return o},{})).forEach(([k,v])=>process.env[k]=v)\" && npm run migrate -w gateway",
    "seed": "npm run seed -w gateway --"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.19.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
