# Copy to .env and fill in. Never commit .env — it is gitignored.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- required, no defaults; the process refuses to start without these -------
DATABASE_URL=postgresql://tollgate:tollgate@localhost:5432/tollgate
REDIS_URL=redis://localhost:6379

# --- session signing secret --------------------------------------------------
# Signs dashboard session cookies (HMAC-SHA256). Anyone who knows this value can
# forge a session for any user in any organization, so it is a real secret:
# never commit it, never share it between environments, never reuse a value from
# a README or a tutorial.
#
# REQUIRED in production. Startup fails there if it is missing, is a known
# placeholder, is under 32 characters, or looks non-random. Left blank in
# development, a labelled insecure fallback is used — that fallback is itself on
# the rejected list, so it cannot leak into production.
#
# Generate one:
#   openssl rand -base64 32
#
# Deliberately blank here. Do not paste a real secret into this file.
AUTH_SECRET=

# --- providers ---------------------------------------------------------------
# Comma-separated. "mock" must stay enabled so the repo runs with no credentials.
ENABLED_PROVIDERS=mock

# Only needed when "openai" is in ENABLED_PROVIDERS. Without it the provider is
# skipped at startup rather than failing on the first request.
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint: Groq, Together, vLLM, Ollama, LiteLLM.
OPENAI_BASE_URL=

# --- gateway behaviour -------------------------------------------------------
RATE_LIMIT_PER_MINUTE=600
CACHE_TTL_SECONDS=300
UPSTREAM_TIMEOUT_MS=30000

# Origin allowed to send credentialed requests. Unused when the gateway serves
# the dashboard itself, which is the production setup.
CORS_ORIGIN=http://localhost:5173
