# Copy to .env. Never commit .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgresql://tollgate:tollgate@localhost:5432/tollgate
REDIS_URL=redis://localhost:6379

# Comma-separated. "mock" must stay enabled so the repo runs with no credentials.
ENABLED_PROVIDERS=mock

# Gateway behaviour
RATE_LIMIT_PER_MINUTE=600
CACHE_TTL_SECONDS=300
UPSTREAM_TIMEOUT_MS=30000
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
